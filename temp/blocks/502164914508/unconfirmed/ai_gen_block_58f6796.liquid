{% doc %}
  @prompt
    A mobile friedly block for 2 small rectangular images can be uploaded and shown on the front end , add option for image to exactly fit within the block, the images need to be linkable to a product or collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-image-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-dual-image-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-dual-image-item-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-dual-image-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    text-decoration: none;
  }

  .ai-dual-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    background-color: #f4f4f4;
  }

  .ai-dual-image-wrapper-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    transition: transform 0.3s ease;
  }

  .ai-dual-image-link-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-dual-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-dual-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-image-container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<dual-images-{{ ai_gen_id }} class="ai-dual-image-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-image-container-{{ ai_gen_id }}">
    <div class="ai-dual-image-item-{{ ai_gen_id }}">
      {% if block.settings.link_1 != blank %}
        <a href="{{ block.settings.link_1 }}" class="ai-dual-image-link-{{ ai_gen_id }}">
          <div class="ai-dual-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.image_1 %}
              <img
                src="{{ block.settings.image_1 | image_url: width: 800 }}"
                alt="{{ block.settings.image_1.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_1.width }}"
                height="{{ block.settings.image_1.height }}"
              >
            {% else %}
              <div class="ai-dual-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </a>
      {% else %}
        <div class="ai-dual-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_1 %}
            <img
              src="{{ block.settings.image_1 | image_url: width: 800 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_1.width }}"
              height="{{ block.settings.image_1.height }}"
            >
          {% else %}
            <div class="ai-dual-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="ai-dual-image-item-{{ ai_gen_id }}">
      {% if block.settings.link_2 != blank %}
        <a href="{{ block.settings.link_2 }}" class="ai-dual-image-link-{{ ai_gen_id }}">
          <div class="ai-dual-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.image_2 %}
              <img
                src="{{ block.settings.image_2 | image_url: width: 800 }}"
                alt="{{ block.settings.image_2.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image_2.width }}"
                height="{{ block.settings.image_2.height }}"
              >
            {% else %}
              <div class="ai-dual-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        </a>
      {% else %}
        <div class="ai-dual-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_2 %}
            <img
              src="{{ block.settings.image_2 | image_url: width: 800 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_2.width }}"
              height="{{ block.settings.image_2.height }}"
            >
          {% else %}
            <div class="ai-dual-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</dual-images-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Dual images",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "50",
          "label": "Landscape (2:1)"
        },
        {
          "value": "66.67",
          "label": "Landscape (3:2)"
        },
        {
          "value": "75",
          "label": "Landscape (4:3)"
        },
        {
          "value": "100",
          "label": "Square (1:1)"
        },
        {
          "value": "133.33",
          "label": "Portrait (3:4)"
        },
        {
          "value": "150",
          "label": "Portrait (2:3)"
        }
      ],
      "default": "75"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill container"
        },
        {
          "value": "contain",
          "label": "Fit within container"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "row",
          "label": "Side by side"
        },
        {
          "value": "column",
          "label": "Stacked"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Dual images"
    }
  ]
}
{% endschema %}