{% doc %}
  @prompt
    A custom dual image block for rectangular images where the container wrapping image settings. The images need to be linkable and have a section for text underneath , need like 'fit to image' setting, when the images are added and set to contain, there is so much vertical spacing
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dual-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-dual-image-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-dual-image-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-dual-image-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-dual-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.image_fit == 'contain' %}
      display: flex;
      align-items: center;
      justify-content: center;
    {% else %}
      aspect-ratio: {{ block.settings.aspect_ratio }};
    {% endif %}
    position: relative;
  }

  .ai-dual-image-img-{{ ai_gen_id }} {
    {% if block.settings.image_fit == 'contain' %}
      max-width: 100%;
      height: auto;
      display: block;
    {% else %}
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.image_fit }};
      display: block;
    {% endif %}
  }

  .ai-dual-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-dual-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-dual-image-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-align: {{ block.settings.text_alignment }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-dual-image-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_mobile }}px;
    }
  }
{% endstyle %}

<dual-image-block-{{ ai_gen_id }} class="ai-dual-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dual-image-container-{{ ai_gen_id }}">
    <div class="ai-dual-image-item-{{ ai_gen_id }}">
      {% if block.settings.image_1_link != blank %}
        <a href="{{ block.settings.image_1_link }}" class="ai-dual-image-link-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-dual-image-link-{{ ai_gen_id }}">
      {% endif %}
        <div class="ai-dual-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_1 %}
            <img
              src="{{ block.settings.image_1 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_1.width }}"
              height="{{ block.settings.image_1.height }}"
              class="ai-dual-image-img-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% if block.settings.image_1_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
      
      {% if block.settings.text_1 != blank %}
        <div class="ai-dual-image-text-{{ ai_gen_id }}">
          {{ block.settings.text_1 }}
        </div>
      {% endif %}
    </div>

    <div class="ai-dual-image-item-{{ ai_gen_id }}">
      {% if block.settings.image_2_link != blank %}
        <a href="{{ block.settings.image_2_link }}" class="ai-dual-image-link-{{ ai_gen_id }}">
      {% else %}
        <div class="ai-dual-image-link-{{ ai_gen_id }}">
      {% endif %}
        <div class="ai-dual-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image_2 %}
            <img
              src="{{ block.settings.image_2 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_2.width }}"
              height="{{ block.settings.image_2.height }}"
              class="ai-dual-image-img-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-dual-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% if block.settings.image_2_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
      
      {% if block.settings.text_2 != blank %}
        <div class="ai-dual-image-text-{{ ai_gen_id }}">
          {{ block.settings.text_2 }}
        </div>
      {% endif %}
    </div>
  </div>
</dual-image-block-{{ ai_gen_id }}>

<script>
  (function() {
    class DualImageBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('dual-image-block-{{ ai_gen_id }}', DualImageBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Dual image block",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "image_1_link",
      "label": "Link"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Text",
      "default": "<p>Add descriptive text for image 1</p>"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "image_2_link",
      "label": "Link"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text",
      "default": "<p>Add descriptive text for image 2</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "info": "Only applies when image fit is set to Cover or Fill",
      "options": [
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "5 / 4",
          "label": "Landscape (5:4)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Landscape (16:9)"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Shows behind images when using Contain fit",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images (desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between images (mobile)",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Space between image and text",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1c1c1c"
    }
  ],
  "presets": [
    {
      "name": "Dual image block"
    }
  ]
}
{% endschema %}
