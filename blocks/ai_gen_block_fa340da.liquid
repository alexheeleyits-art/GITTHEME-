{% doc %}
  @prompt
    add section where i can have a star rating along the top, text underneath then an image below that with a link under that, these should sit 2 wide on desktop with the option to have only one , ADD IMAGE SIZING SLIDER TO MAKE IT SMALLER
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rating-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-rating-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-rating-grid__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.alignment }};
    text-align: {{ block.settings.alignment }};
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-rating-grid__stars-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.star_spacing }}px;
  }

  .ai-rating-grid__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-rating-grid__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-rating-grid__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    position: relative;
  }

  .ai-rating-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-rating-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-rating-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-rating-grid__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    text-decoration: underline;
    transition: opacity 0.3s ease;
  }

  .ai-rating-grid__link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-rating-grid__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-rating-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-rating-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-rating-grid__container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign rating_key = 'item_' | append: i | append: '_rating'
        assign text_key = 'item_' | append: i | append: '_text'
        assign image_key = 'item_' | append: i | append: '_image'
        assign link_text_key = 'item_' | append: i | append: '_link_text'
        assign link_url_key = 'item_' | append: i | append: '_link_url'

        assign item_enabled = block.settings[item_enabled_key]
        assign rating = block.settings[rating_key]
        assign text = block.settings[text_key]
        assign image = block.settings[image_key]
        assign link_text = block.settings[link_text_key]
        assign link_url = block.settings[link_url_key]
      %}

      {% if item_enabled %}
        <div class="ai-rating-grid__item-{{ ai_gen_id }}">
          <div class="ai-rating-grid__stars-{{ ai_gen_id }}">
            {% for star in (1..5) %}
              <svg
                class="ai-rating-grid__star-{{ ai_gen_id }} {% if star <= rating %}ai-rating-grid__star--filled-{{ ai_gen_id }}{% else %}ai-rating-grid__star--empty-{{ ai_gen_id }}{% endif %}"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                {% if star <= rating %}
                  fill="currentColor"
                {% else %}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                {% endif %}
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {% endfor %}
          </div>

          {% if text != blank %}
            <div class="ai-rating-grid__text-{{ ai_gen_id }}">{{ text }}</div>
          {% endif %}

          <div class="ai-rating-grid__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-rating-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-rating-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if link_text != blank and link_url != blank %}
            <a href="{{ link_url }}" class="ai-rating-grid__link-{{ ai_gen_id }}">
              {{ link_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

