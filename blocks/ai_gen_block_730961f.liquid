{% doc %}
  @prompt
    a 3 wide linkable banner section that i can add images too, change padding etc, the images need to be 300x100 dimensions
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-grid-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_horizontal }}px;
    padding-right: {{ block.settings.padding_horizontal }}px;
  }

  .ai-banner-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-banner-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-banner-grid__link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    text-decoration: none;
    height: 100%;
  }

  .ai-banner-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100px;
    overflow: hidden;
  }

  .ai-banner-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-banner-grid__link-{{ ai_gen_id }}:hover .ai-banner-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-banner-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-grid__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-banner-grid__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 12px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-banner-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    transition: opacity 0.3s ease;
  }

  .ai-banner-grid__link-{{ ai_gen_id }}:hover .ai-banner-grid__overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_opacity_hover }};
  }

  .ai-banner-grid__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    z-index: 1;
  }

  .ai-banner-grid__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 4px;
    font-weight: 700;
    text-transform: {{ block.settings.text_transform }};
  }

  .ai-banner-grid__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-banner-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-banner-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-banner-grid__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-banner-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-banner-grid-{{ ai_gen_id }} {
      padding-left: {{ block.settings.padding_horizontal | times: 0.5 }}px;
      padding-right: {{ block.settings.padding_horizontal | times: 0.5 }}px;
    }

    .ai-banner-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-banner-grid__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-banner-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-grid__container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign subtitle_key = 'subtitle_' | append: i
        assign link_key = 'link_' | append: i

        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign subtitle = block.settings[subtitle_key]
        assign link = block.settings[link_key]
      %}

      <div class="ai-banner-grid__item-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-banner-grid__link-{{ ai_gen_id }}">
        {% else %}
          <div class="ai-banner-grid__link-{{ ai_gen_id }}">
        {% endif %}

          <div class="ai-banner-grid__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 300 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="300"
                height="100"
                class="ai-banner-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-banner-grid__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-banner-grid__empty-state-{{ ai_gen_id }}">
                  Add image {{ i }}
                </div>
              </div>
            {% endif %}

            {% if block.settings.show_overlay %}
              <div class="ai-banner-grid__overlay-{{ ai_gen_id }}"></div>
            {% endif %}

            {% if title != blank or subtitle != blank %}
              <div class="ai-banner-grid__content-{{ ai_gen_id }}">
                {% if title != blank %}
                  <h3 class="ai-banner-grid__title-{{ ai_gen_id }}">{{ title }}</h3>
                {% endif %}
                {% if subtitle != blank %}
                  <p class="ai-banner-grid__subtitle-{{ ai_gen_id }}">{{ subtitle }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>

        {% if link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "3 column banner grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
