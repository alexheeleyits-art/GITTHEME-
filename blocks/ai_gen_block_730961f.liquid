    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title",
      "default": "Banner 3"
    },
    {
      "type": "text",
      "id": "subtitle_3",
