{% doc %}
  @prompt
    I'd like a section that is desktop 2 section wide where i can have, Image then underneath a rich text section with sub heading heading and then text, then below that a button. I would also like the option to have 8 of these, but i'd also like an additional option in stead of image stacked ontop of rich text, i'd like an option to add an image and have the rich text etc sit inside the image. Font selectability size and spacing need to be an option too, rich text needs content allignment options, give me image sizing options and font spacing /gaps for the rich text sectioj, need image sizing as a slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-content-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-content-grid__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ai-content-grid__item--overlay-{{ ai_gen_id }} {
    position: relative;
    min-height: {{ block.settings.overlay_min_height }}px;
  }

  .ai-content-grid__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-content-grid__image-wrapper--overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-content-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-content-grid__image--overlay-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.overlay_image_fit }};
  }

  .ai-content-grid__image--stacked-{{ ai_gen_id }} {
    height: {{ block.settings.stacked_image_height }}px;
    object-fit: {{ block.settings.stacked_image_fit }};
  }

  .ai-content-grid__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: {{ block.settings.stacked_image_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-content-grid__image-placeholder--overlay-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-content-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-content-grid__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
    margin-top: {{ block.settings.content_top_spacing }}px;
  }

  .ai-content-grid__content--stacked-left-{{ ai_gen_id }} {
    align-items: flex-start;
    text-align: left;
  }

  .ai-content-grid__content--stacked-center-{{ ai_gen_id }} {
    align-items: center;
    text-align: center;
  }

  .ai-content-grid__content--stacked-right-{{ ai_gen_id }} {
    align-items: flex-end;
    text-align: right;
  }

  .ai-content-grid__content--overlay-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: {{ block.settings.overlay_padding }}px;
    margin-top: 0;
    height: 100%;
    justify-content: {{ block.settings.overlay_vertical_alignment }};
    align-items: {{ block.settings.overlay_horizontal_alignment }};
    text-align: {% if block.settings.overlay_horizontal_alignment == 'flex-start' %}left{% elsif block.settings.overlay_horizontal_alignment == 'flex-end' %}right{% else %}center{% endif %};
  }

  .ai-content-grid__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: {{ block.settings.subheading_line_height }};
    margin: 0;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-content-grid__subheading--overlay-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-content-grid__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    margin: 0;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-content-grid__heading--overlay-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-content-grid__text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    margin: 0;
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-content-grid__text--overlay-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-content-grid__button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_spacing }}px;
  }

  .ai-content-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: background-color 0.3s ease;
  }

  .ai-content-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-content-grid__button--overlay-{{ ai_gen_id }} {
    background-color: {{ block.settings.overlay_button_background }};
    color: {{ block.settings.overlay_button_text_color }};
  }

  .ai-content-grid__button--overlay-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.overlay_button_hover_background }};
    color: {{ block.settings.overlay_button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-content-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-content-grid__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.85);
    }

    .ai-content-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-content-grid__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-content-grid__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_size }}px * 0.9);
    }
  }
{% endstyle %}

<content-grid-{{ ai_gen_id }} class="ai-content-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-grid__container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign layout_key = 'item_' | append: i | append: '_layout'
        assign alignment_key = 'item_' | append: i | append: '_alignment'
        assign image_key = 'item_' | append: i | append: '_image'
        assign subheading_key = 'item_' | append: i | append: '_subheading'
        assign heading_key = 'item_' | append: i | append: '_heading'
        assign text_key = 'item_' | append: i | append: '_text'
        assign button_text_key = 'item_' | append: i | append: '_button_text'
        assign button_link_key = 'item_' | append: i | append: '_button_link'

        assign item_enabled = block.settings[item_enabled_key]
        assign layout = block.settings[layout_key]
        assign alignment = block.settings[alignment_key]
        assign image = block.settings[image_key]
        assign subheading = block.settings[subheading_key]
        assign heading = block.settings[heading_key]
        assign text = block.settings[text_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
      %}

      {% if item_enabled %}
        {% if layout == 'stacked' %}
          <div class="ai-content-grid__item-{{ ai_gen_id }}">
            <div class="ai-content-grid__image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-content-grid__image-{{ ai_gen_id }} ai-content-grid__image--stacked-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-content-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-content-grid__content-{{ ai_gen_id }} ai-content-grid__content--stacked-{{ alignment }}-{{ ai_gen_id }}">
              {% if subheading != blank %}
                <div class="ai-content-grid__subheading-{{ ai_gen_id }}">
                  {{ subheading }}
                </div>
              {% endif %}

              {% if heading != blank %}
                <h3 class="ai-content-grid__heading-{{ ai_gen_id }}">
                  {{ heading }}
                </h3>
              {% endif %}

              {% if text != blank %}
                <div class="ai-content-grid__text-{{ ai_gen_id }}">
                  {{ text }}
                </div>
              {% endif %}

              {% if button_text != blank %}
                <div class="ai-content-grid__button-wrapper-{{ ai_gen_id }}">
                  <a href="{{ button_link }}" class="ai-content-grid__button-{{ ai_gen_id }}">
                    {{ button_text }}
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="ai-content-grid__item-{{ ai_gen_id }} ai-content-grid__item--overlay-{{ ai_gen_id }}">
            <div class="ai-content-grid__image-wrapper-{{ ai_gen_id }} ai-content-grid__image-wrapper--overlay-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 1200 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-content-grid__image-{{ ai_gen_id }} ai-content-grid__image--overlay-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-content-grid__image-placeholder-{{ ai_gen_id }} ai-content-grid__image-placeholder--overlay-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-content-grid__content-{{ ai_gen_id }} ai-content-grid__content--overlay-{{ ai_gen_id }}">
              <div>
                {% if subheading != blank %}
                  <div class="ai-content-grid__subheading-{{ ai_gen_id }} ai-content-grid__subheading--overlay-{{ ai_gen_id }}">
                    {{ subheading }}
                  </div>
                {% endif %}

                {% if heading != blank %}
                  <h3 class="ai-content-grid__heading-{{ ai_gen_id }} ai-content-grid__heading--overlay-{{ ai_gen_id }}">
                    {{ heading }}
                  </h3>
                {% endif %}

                {% if text != blank %}
                  <div class="ai-content-grid__text-{{ ai_gen_id }} ai-content-grid__text--overlay-{{ ai_gen_id }}">
                    {{ text }}
                  </div>
                {% endif %}

                {% if button_text != blank %}
                  <div class="ai-content-grid__button-wrapper-{{ ai_gen_id }}">
                    <a href="{{ button_link }}" class="ai-content-grid__button-{{ ai_gen_id }} ai-content-grid__button--overlay-{{ ai_gen_id }}">
                      {{ button_text }}
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</content-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ContentGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('content-grid-{{ ai_gen_id }}', ContentGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Content grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
