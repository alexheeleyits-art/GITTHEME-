{% doc %}
  @prompt
    like slide show functionality where i can add an image with heading and sub heading but i also need an area to add paragprah text. copy slideshow funcitonality and add paragraph copy section, i need to be able to offset the text and headings to like middle left top left etc , be able to select what font the headin and paragraph is too, ADD AN OPTION TO MANAGE MAX WIDTH OF THE HEADING/TEXT ZONE, FONT HEIGHT SPACING ADD THAT
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-slideshow-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.slide_height_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-slideshow-container-{{ ai_gen_id }} {
      height: {{ block.settings.slide_height_desktop }}px;
    }
  }

  .ai-slideshow-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slideshow-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ block.settings.transition_speed }}s ease-in-out;
  }

  .ai-slideshow-slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .ai-slideshow-slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-slideshow-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slideshow-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-slideshow-content-{{ ai_gen_id }} {
    position: absolute;
    color: {{ block.settings.text_color }};
    width: 90%;
    max-width: {{ block.settings.content_max_width }}px;
    z-index: 2;
    padding: 20px;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-top-left {
    top: 40px;
    left: 40px;
    transform: none;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-top-center {
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-top-right {
    top: 40px;
    right: 40px;
    left: auto;
    transform: none;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-middle-left {
    top: 50%;
    left: 40px;
    transform: translateY(-50%);
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-middle-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-middle-right {
    top: 50%;
    right: 40px;
    left: auto;
    transform: translateY(-50%);
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-left {
    bottom: 40px;
    left: 40px;
    top: auto;
    transform: none;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-center {
    bottom: 40px;
    left: 50%;
    top: auto;
    transform: translateX(-50%);
  }

  .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-right {
    bottom: 40px;
    right: 40px;
    left: auto;
    top: auto;
    transform: none;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.align-left {
    text-align: left;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.align-center {
    text-align: center;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.align-right {
    text-align: right;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.align-left .ai-slideshow-paragraph-{{ ai_gen_id }} {
    margin-left: 0;
    margin-right: 0;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.align-center .ai-slideshow-paragraph-{{ ai_gen_id }} {
    margin-left: auto;
    margin-right: auto;
  }

  .ai-slideshow-content-{{ ai_gen_id }}.align-right .ai-slideshow-paragraph-{{ ai_gen_id }} {
    margin-left: auto;
    margin-right: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-slideshow-content-{{ ai_gen_id }}.position-top-left,
    .ai-slideshow-content-{{ ai_gen_id }}.position-middle-left,
    .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-left {
      left: 20px;
    }

    .ai-slideshow-content-{{ ai_gen_id }}.position-top-right,
    .ai-slideshow-content-{{ ai_gen_id }}.position-middle-right,
    .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-right {
      right: 20px;
    }

    .ai-slideshow-content-{{ ai_gen_id }}.position-top-left,
    .ai-slideshow-content-{{ ai_gen_id }}.position-top-center,
    .ai-slideshow-content-{{ ai_gen_id }}.position-top-right {
      top: 20px;
    }

    .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-left,
    .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-center,
    .ai-slideshow-content-{{ ai_gen_id }}.position-bottom-right {
      bottom: 20px;
    }
  }

  .ai-slideshow-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.content_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
  }

  @media screen and (min-width: 750px) {
    .ai-slideshow-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-slideshow-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: {{ block.settings.subheading_size_mobile }}px;
    line-height: {{ block.settings.subheading_line_height }};
    margin: 0 0 {{ block.settings.content_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-slideshow-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }
  }

  .ai-slideshow-paragraph-{{ ai_gen_id }} {
    font-family: {{ block.settings.paragraph_font.family }}, {{ block.settings.paragraph_font.fallback_families }};
    font-weight: {{ block.settings.paragraph_font.weight }};
    font-style: {{ block.settings.paragraph_font.style }};
    font-size: {{ block.settings.paragraph_size_mobile }}px;
    line-height: {{ block.settings.paragraph_line_height }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-slideshow-paragraph-{{ ai_gen_id }} {
      font-size: {{ block.settings.paragraph_size_desktop }}px;
    }
  }

  .ai-slideshow-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }

  .ai-slideshow-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_icon_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-nav-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-slideshow-nav-prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-slideshow-nav-next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-slideshow-nav-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-slideshow-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-slideshow-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slideshow-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-slideshow-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 4;
  }
{% endstyle %}

<slideshow-{{ ai_gen_id }}
  class="ai-slideshow-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-slideshow-container-{{ ai_gen_id }}">
    <div class="ai-slideshow-slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign slide_image_key = 'slide_' | append: i | append: '_image'
          assign slide_heading_key = 'slide_' | append: i | append: '_heading'
          assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'
          assign slide_paragraph_key = 'slide_' | append: i | append: '_paragraph'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign slide_image = block.settings[slide_image_key]
          assign slide_heading = block.settings[slide_heading_key]
          assign slide_subheading = block.settings[slide_subheading_key]
          assign slide_paragraph = block.settings[slide_paragraph_key]
        %}

        {% if slide_enabled %}
          <div
            class="ai-slideshow-slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
          >
            {% if slide_image %}
              <img
                src="{{ slide_image | image_url: width: 2000 }}"
                alt="{{ slide_image.alt | escape }}"
                loading="lazy"
                width="{{ slide_image.width }}"
                height="{{ slide_image.height }}"
                class="ai-slideshow-slide-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-slideshow-slide-placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-slideshow-overlay-{{ ai_gen_id }}"></div>

            <div class="ai-slideshow-content-{{ ai_gen_id }} position-{{ block.settings.content_position }} align-{{ block.settings.text_alignment }}">
              {% if slide_heading != blank %}
                <h2 class="ai-slideshow-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
              {% endif %}

              {% if slide_subheading != blank %}
                <p class="ai-slideshow-subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
              {% endif %}

              {% if slide_paragraph != blank %}
                <div class="ai-slideshow-paragraph-{{ ai_gen_id }}">{{ slide_paragraph }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="ai-slideshow-nav-{{ ai_gen_id }} ai-slideshow-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-slideshow-nav-{{ ai_gen_id }} ai-slideshow-nav-next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-slideshow-dots-{{ ai_gen_id }}"></div>
    {% endif %}

    {% assign has_slides = false %}
    {% for i in (1..5) %}
      {% assign slide_enabled_key = 'slide_' | append: i | append: '_enabled' %}
      {% if block.settings[slide_enabled_key] %}
        {% assign has_slides = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% unless has_slides %}
      <div class="ai-slideshow-empty-state-{{ ai_gen_id }}">
        Next, enable and configure your slides
      </div>
    {% endunless %}
  </div>
</slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class Slideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slideshow-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slideshow-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-slideshow-nav-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-slideshow-dots-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        if (this.slides.length === 0) return;

        this.setupEventListeners();
        this.createDots();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToSlide(this.currentSlide - 1);
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToSlide(this.currentSlide + 1);
            this.resetAutoplay();
          });
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-slideshow-dot-{{ ai_gen_id }}');
          if (index === 0) dot.classList.add('active');
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));

          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.resetAutoplay();
          });

          this.dotsContainer.appendChild(dot);
        });

        this.dots = this.querySelectorAll('.ai-slideshow-dot-{{ ai_gen_id }}');
      }

      goToSlide(index) {
        if (index < 0) {
          index = this.slides.length - 1;
        } else if (index >= this.slides.length) {
          index = 0;
        }

        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.goToSlide(this.currentSlide + 1);
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        if (this.autoplay) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('slideshow-{{ ai_gen_id }}', Slideshow{{ ai_gen_id }});
  })();
</script>

