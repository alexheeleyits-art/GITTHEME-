{% doc %}
  @prompt
    a cetegory carousel which i can add images and links to that can be dyanimcally linked to metafields , make the images circular 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
    padding: 0 20px;
  }

  .ai-category-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 10%;
  }

  .ai-category-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-category-carousel__container-{{ ai_gen_id }} {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-carousel__track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-category-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-category-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.items_per_row_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.items_per_row_desktop }});
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.items_per_row_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.items_per_row_mobile }});
    }
  }

  .ai-category-carousel__card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-category-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
    border-radius: 50%;
  }

  .ai-category-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-category-carousel__card-{{ ai_gen_id }}:hover .ai-category-carousel__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-category-carousel__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-category-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-carousel__category-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_name_size }}px;
    font-weight: 600;
    margin: 15px 0 0;
    text-transform: uppercase;
    letter-spacing: 5%;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 30px;
  }

  .ai-category-carousel__button-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.nav_button_color }};
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-category-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_background }};
  }

  .ai-category-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-category-carousel__button-{{ ai_gen_id }}:disabled:hover {
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
  }

  .ai-category-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-category-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-category-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-category-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-category-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }
{% endstyle %}

<category-carousel-{{ ai_gen_id }} class="ai-category-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-category-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-category-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-category-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% liquid
    assign has_items = false
    for i in (1..8)
      assign image_key = 'category_' | append: i | append: '_image'
      assign enabled_key = 'category_' | append: i | append: '_enabled'
      if block.settings[enabled_key]
        assign has_items = true
        break
      endif
    endfor
  %}

  {% if has_items %}
    <div class="ai-category-carousel__container-{{ ai_gen_id }}">
      <div class="ai-category-carousel__track-wrapper-{{ ai_gen_id }}">
        <div class="ai-category-carousel__track-{{ ai_gen_id }}" data-track>
          {% for i in (1..8) %}
            {% liquid
              assign enabled_key = 'category_' | append: i | append: '_enabled'
              assign image_key = 'category_' | append: i | append: '_image'
              assign name_key = 'category_' | append: i | append: '_name'
              assign link_key = 'category_' | append: i | append: '_link'

              assign enabled = block.settings[enabled_key]
              assign image = block.settings[image_key]
              assign name = block.settings[name_key]
              assign link = block.settings[link_key]
            %}

            {% if enabled %}
              <div class="ai-category-carousel__item-{{ ai_gen_id }}">
                <a 
                  href="{% if link != blank %}{{ link }}{% else %}#{% endif %}" 
                  class="ai-category-carousel__card-{{ ai_gen_id }}"
                >
                  <div class="ai-category-carousel__image-wrapper-{{ ai_gen_id }}">
                    {% if image %}
                      <img
                        src="{{ image | image_url: width: 600 }}"
                        alt="{{ image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                        class="ai-category-carousel__image-{{ ai_gen_id }}"
                      >
                    {% else %}
                      <div class="ai-category-carousel__image-placeholder-{{ ai_gen_id }}">
                        {{ 'collection-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  {% if name != blank %}
                    <h3 class="ai-category-carousel__category-name-{{ ai_gen_id }}">{{ name }}</h3>
                  {% endif %}
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-category-carousel__nav-{{ ai_gen_id }}">
        <button 
          class="ai-category-carousel__button-{{ ai_gen_id }}" 
          data-prev
          aria-label="Previous slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-category-carousel__dots-{{ ai_gen_id }}" data-dots></div>

        <button 
          class="ai-category-carousel__button-{{ ai_gen_id }}" 
          data-next
          aria-label="Next slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  {% else %}
    <div class="ai-category-carousel__empty-state-{{ ai_gen_id }}">
      {{ 'collection-1' | placeholder_svg_tag }}
      <p>Enable categories and add images to get started</p>
    </div>
  {% endif %}
</category-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerPage = 1;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');

        if (!this.track) return;

        this.items = Array.from(this.track.children);
        this.totalItems = this.items.length;

        this.calculateItemsPerPage();
        this.createDots();
        this.updateCarousel();
        this.setupEventListeners();

        window.addEventListener('resize', () => {
          this.calculateItemsPerPage();
          this.createDots();
          this.updateCarousel();
        });
      }

      calculateItemsPerPage() {
        const isMobile = window.innerWidth < 750;
        this.itemsPerPage = isMobile ? {{ block.settings.items_per_row_mobile }} : {{ block.settings.items_per_row_desktop }};
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        this.totalPages = Math.ceil(this.totalItems / this.itemsPerPage);

        for (let i = 0; i < this.totalPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-category-carousel__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToPage(i));
          this.dotsContainer.appendChild(dot);
        }

        this.dots = Array.from(this.dotsContainer.children);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        const maxIndex = Math.ceil(this.totalItems / this.itemsPerPage) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToPage(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ block.settings.gap }};
        const offset = -(this.currentIndex * this.itemsPerPage * (itemWidth + gap));
        
        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          const maxIndex = Math.ceil(this.totalItems / this.itemsPerPage) - 1;
          this.nextButton.disabled = this.currentIndex >= maxIndex;
        }

        if (this.dots) {
          this.dots.forEach((dot, index) => {
            if (index === this.currentIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }
    }

    customElements.define('category-carousel-{{ ai_gen_id }}', CategoryCarousel{{ ai_gen_id }});
  })();
</script>

