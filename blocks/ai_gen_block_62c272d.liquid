{% doc %}
  @prompt
    3 BUTTONS NEXT TO EACH OTHER WITH TEXT ABOVE THME, The paragraph text needs to sit above each indivitual button, the buttons need to remained aligned despite how much text there is
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-buttons-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-three-buttons__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-three-buttons__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    justify-content: center;
    align-items: stretch;
    flex-wrap: wrap;
  }

  .ai-three-buttons__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    min-width: 200px;
  }

  .ai-three-buttons__text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_button_gap }}px 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    align-items: flex-end;
  }

  .ai-three-buttons__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
    width: 100%;
  }

  .ai-three-buttons__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-three-buttons__wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-three-buttons__item-{{ ai_gen_id }} {
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-three-buttons-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin: 0 auto;
    }
  }
{% endstyle %}

<three-buttons-{{ ai_gen_id }} class="ai-three-buttons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-buttons__container-{{ ai_gen_id }}">
    <div class="ai-three-buttons__wrapper-{{ ai_gen_id }}">
      {% if block.settings.button_1_text != blank %}
        <div class="ai-three-buttons__item-{{ ai_gen_id }}">
          {% if block.settings.button_1_heading != blank %}
            <div class="ai-three-buttons__text-{{ ai_gen_id }}">
              {{ block.settings.button_1_heading }}
            </div>
          {% endif %}
          <a
            href="{{ block.settings.button_1_link }}"
            class="ai-three-buttons__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_1_text }}
          </a>
        </div>
      {% endif %}

      {% if block.settings.button_2_text != blank %}
        <div class="ai-three-buttons__item-{{ ai_gen_id }}">
          {% if block.settings.button_2_heading != blank %}
            <div class="ai-three-buttons__text-{{ ai_gen_id }}">
              {{ block.settings.button_2_heading }}
            </div>
          {% endif %}
          <a
            href="{{ block.settings.button_2_link }}"
            class="ai-three-buttons__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_2_text }}
          </a>
        </div>
      {% endif %}

      {% if block.settings.button_3_text != blank %}
        <div class="ai-three-buttons__item-{{ ai_gen_id }}">
          {% if block.settings.button_3_heading != blank %}
            <div class="ai-three-buttons__text-{{ ai_gen_id }}">
              {{ block.settings.button_3_heading }}
            </div>
          {% endif %}
          <a
            href="{{ block.settings.button_3_link }}"
            class="ai-three-buttons__button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_3_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</three-buttons-{{ ai_gen_id }}>

<script>
  (function() {
    class ThreeButtons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('three-buttons-{{ ai_gen_id }}', ThreeButtons{{ ai_gen_id }});
  })();
</script>

