{% doc %}
  @prompt
    TWO OR MORE CENTERED BUTTONS SECTION
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-buttons-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-buttons-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.button_spacing }}px;
    max-width: 100%;
  }

  .ai-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}%;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-buttons-wrapper-{{ ai_gen_id }} {
      {% if block.settings.stack_on_mobile %}
        flex-direction: column;
        width: 100%;
      {% endif %}
    }

    {% if block.settings.stack_on_mobile %}
      .ai-button-{{ ai_gen_id }} {
        width: 100%;
      }
    {% endif %}
  }
{% endstyle %}

<centered-buttons-{{ ai_gen_id }} class="ai-buttons-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-buttons-wrapper-{{ ai_gen_id }}">
    {% if block.settings.button_1_text != blank %}
      <a href="{{ block.settings.button_1_link }}" class="ai-button-{{ ai_gen_id }}">
        {{ block.settings.button_1_text }}
      </a>
    {% endif %}

    {% if block.settings.button_2_text != blank %}
      <a href="{{ block.settings.button_2_link }}" class="ai-button-{{ ai_gen_id }}">
        {{ block.settings.button_2_text }}
      </a>
    {% endif %}

    {% if block.settings.button_3_text != blank %}
      <a href="{{ block.settings.button_3_link }}" class="ai-button-{{ ai_gen_id }}">
        {{ block.settings.button_3_text }}
      </a>
    {% endif %}

    {% if block.settings.button_4_text != blank %}
      <a href="{{ block.settings.button_4_link }}" class="ai-button-{{ ai_gen_id }}">
        {{ block.settings.button_4_text }}
      </a>
    {% endif %}
  </div>
</centered-buttons-{{ ai_gen_id }}>

<script>
  (function() {
    class CenteredButtons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('centered-buttons-{{ ai_gen_id }}', CenteredButtons{{ ai_gen_id }});
  })();
</script>

