      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 3"
    },
    {
      "type": "text",
      "id": "button_3_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_3_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button 4"
    },
    {
      "type": "text",
      "id": "button_4_text",
      "label": "Text"
    },
